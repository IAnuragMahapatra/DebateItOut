DB_HOST=db
DB_PORT=5432
DB_NAME=debateitout
DB_USER=debateitout
DB_PASSWORD=debateitout

PORT=3002
MAX_TOKENS=16384

# DebateItOut-specific
DEFAULT_MAX_ROUNDS=6
AUTO_ADVANCE=true
REVEAL_OPPONENT_IDENTITY=false
MAX_CONTEXT_TOKENS=8000
# MAX_CONTEXT_TOKENS_<ID>=32000    # per-model override (optional)

# Model pattern: MODEL_<ID>_<FIELD>
# IMPORTANT: use hyphens in <ID>, not underscores — the underscore separates ID from field.
# Good: MODEL_GPT-4O_NAME  Bad: MODEL_GPT_4O_NAME
MODEL_CLAUDE_NAME=claude-sonnet-4-6
MODEL_CLAUDE_TYPE=anthropic
MODEL_CLAUDE_API_URL=https://api.anthropic.com/v1/messages
MODEL_CLAUDE_API_KEY=sk-ant-api03-...
MODEL_CLAUDE_ANTHROPIC_VERSION=2023-06-01
MODEL_CLAUDE_SLUG=claude-sonnet-4-6

MODEL_DEEPSEEK_NAME=deepseek-v3.2
MODEL_DEEPSEEK_TYPE=openai
MODEL_DEEPSEEK_API_URL=http://host.docker.internal:11434/v1/chat/completions
MODEL_DEEPSEEK_API_KEY=ollama
MODEL_DEEPSEEK_SLUG=deepseek-v3.2:cloud

MODEL_GPT-4O_NAME=GPT-4o
MODEL_GPT-4O_TYPE=openai
MODEL_GPT-4O_API_URL=https://api.openai.com/v1/chat/completions
MODEL_GPT-4O_API_KEY=sk-...
MODEL_GPT-4O_SLUG=gpt-4o
