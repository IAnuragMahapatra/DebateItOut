DB_HOST=db
DB_PORT=5432
DB_NAME=promptcouncil
DB_USER=promptcouncil
DB_PASSWORD=promptcouncil

PORT=3001
MAX_TOKENS=16384

# Model pattern: MODEL_<ID>_<FIELD>
# TYPE is either "anthropic" or "openai"
# API_URL should use host.docker.internal to reach services on your laptop

MODEL_CLAUDE_NAME=claude-sonnet-4-5
MODEL_CLAUDE_TYPE=anthropic
MODEL_CLAUDE_API_URL=https://api.anthropic.com/v1/messages
MODEL_CLAUDE_API_KEY=your_anthropic_api_key
MODEL_CLAUDE_ANTHROPIC_VERSION=2023-06-01
MODEL_CLAUDE_MODEL=claude-sonnet-4-5

MODEL_GPT_NAME=gpt-4o
MODEL_GPT_TYPE=openai
MODEL_GPT_API_URL=https://api.openai.com/v1/chat/completions
MODEL_GPT_API_KEY=your_openai_api_key
MODEL_GPT_MODEL=gpt-4o

# For services running natively on your machine (Ollama, proxies etc.)
# use host.docker.internal instead of localhost:
# MODEL_OLLAMA_API_URL=http://host.docker.internal:11434/v1/chat/completions
